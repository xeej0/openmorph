{
  "name": "openmorph",
  "version": "1.0.0",
  "description": "Free, open-source, private file converter, compressor and resizer that runs entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "copy-core": "node scripts/copy-core.mjs",
    "dev": "npm run copy-core && vite",
    "build": "npm run copy-core && vite build",
    "preview": "vite preview",
    "test": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "heic2any": "^0.0.4",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xeej0/openmorph.git"
  },
  "homepage": "https://openmorph.vercel.app",
  "private": true,
  "keywords": [
    "file-converter",
    "image-compressor",
    "pdf",
    "ffmpeg",
